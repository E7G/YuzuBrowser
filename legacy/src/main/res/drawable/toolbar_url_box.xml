<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <padding
                android:left="3dp"
                android:top="4dp"
                android:right="3dp"
                android:bottom="4dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?urlBarBoxColor"/>
            <stroke
                android:width="1dp"
                android:color="?urlBarBoxBorderColor"/>
            <padding
                android:left="16dp"
                android:top="4dp"
                android:right="16dp"
                android:bottom="4dp"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
</layer-list>