<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@color/md3_navigation_bar_bg">

    <LinearLayout
        android:id="@+id/leftLinearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"/>

    <jp.hazuki.yuzubrowser.legacy.toolbar.main.WhiteSwipeTextButton
        android:id="@+id/centerUrlButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/md3_search_bar_ripple"
        android:backgroundTint="@color/md3_surface_container_high"
        android:textColor="@color/md3_on_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:drawableStart="@drawable/ic_search_dark_24dp"
        android:drawablePadding="12dp"
        android:drawableTint="@color/md3_on_surface_variant"/>

    <LinearLayout
        android:id="@+id/rightLinearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"/>

</LinearLayout>
