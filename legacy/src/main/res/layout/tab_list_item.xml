<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/md3_surface_container_low"
    app:strokeColor="@color/md3_outline_variant"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/thumbNailImageView"
            android:src="@drawable/empty_thumbnail"
            android:scaleType="centerCrop"
            android:layout_width="100dp"
            android:layout_height="72dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/md3_icon_button_bg"
            android:backgroundTint="@color/md3_surface_container_high"/>

        <LinearLayout
            android:id="@+id/selectLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="88dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/thumbNailImageView"
            android:layout_toStartOf="@+id/closeImageButton">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/md3_on_surface"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/urlTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/md3_on_surface_variant"
                android:textSize="12sp"
                android:ellipsize="end"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/closeImageButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/md3_icon_button_bg"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_close_black_24dp"
            android:tint="@color/md3_on_surface"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"/>

        <ImageButton
            android:id="@+id/tabHistoryImageButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/md3_icon_button_bg"
            android:padding="6dp"
            android:contentDescription="@string/tab_history"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_history_white_24dp"
            android:tint="@color/md3_on_surface_variant"
            android:layout_below="@+id/closeImageButton"
            android:layout_alignParentEnd="true"/>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
