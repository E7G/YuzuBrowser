<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:orientation="vertical"
    android:background="@color/md3_surface_container">

    <jp.hazuki.yuzubrowser.ui.widget.progress.MaterialProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="3dp"
        android:max="100"
        app:mpb_progressBackgroundTint="@android:color/transparent"
        app:mpb_progressTint="@color/md3_primary"
        style="@style/Widget.MaterialProgressBar.ProgressBar.Horizontal"/>

</LinearLayout>
