<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_surface">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/toolbarAppbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_surface"
            android:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/tool_bar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_surface"
                android:elevation="0dp"
                app:titleTextColor="@color/md3_on_surface"
                app:navigationIconTint="@color/md3_on_surface"/>
        </com.google.android.material.appbar.AppBarLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md3_outline_variant"
            app:layout_constraintTop_toBottomOf="@+id/toolbarAppbar"/>

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/subBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_surface_container_low"
            app:layout_constraintTop_toBottomOf="@+id/divider">

            <jp.hazuki.yuzubrowser.ui.widget.breadcrumbs.BreadcrumbsView
                android:id="@+id/breadCrumbsView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:crumbsCurrentItemTextColor="@color/md3_on_surface"
                app:crumbsOtherItemTextColor="@color/md3_on_surface_variant"
                app:crumbsArrowColor="@color/md3_on_surface_variant"/>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:elevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subBar">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <jp.hazuki.yuzubrowser.ui.widget.fastscroll.RecyclerViewFastScroller
                android:id="@+id/fastScroller"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                app:fs_barColor="@color/md3_outline_variant"
                app:fs_handleNormalColor="@color/md3_on_surface_variant"
                app:fs_hideDelay="1200"/>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
