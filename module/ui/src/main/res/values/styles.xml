<resources xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <style name="ToolbarTextButton" parent="@android:style/Widget.Button">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textColor">@color/toolbar_text_color</item>
    </style>

    <style name="ToolbarStyle">
        <item name="android:background">@color/md3_navigation_bar_bg</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="ToolbarImageButton" parent="@android:style/Widget.ImageButton">
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/md3_icon_button_bg</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="BrowserThemeDayNight" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="android:colorBackground">@color/md3_surface</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md3_on_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <item name="android:textColorPrimary">@color/md3_on_surface</item>
        <item name="android:textColorSecondary">@color/md3_on_surface_variant</item>
        <item name="android:colorControlNormal">@color/md3_on_surface_variant</item>
        <item name="android:colorAccent">@color/md3_primary</item>
        <item name="colorAccent">@color/md3_primary</item>
        <item name="android:navigationBarColor">@color/md3_navigation_bar_bg</item>
        <item name="android:statusBarColor">@color/md3_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="spinnerButtonStyle">@style/Widget.Yuzu.SpinnerButton</item>
        <item name="android:webViewStyle">@style/Widget.Yuzu.WebView</item>
        <item name="iconColor">@color/md3_on_surface_variant</item>
        <item name="editTextStyle">@style/EditTextStyle</item>
        <item name="urlBarBoxColor">@color/md3_surface_container_high</item>
        <item name="urlBarBoxBorderColor">@color/md3_outline_variant</item>
        <item name="urlBarBoxBorderColor">@color/md3_outline_variant</item>
        <item name="urlBarBoxBorderColor">@color/urlBarBoxBorderColor</item>
        <item name="actionModeStyle">@style/ActionModeStyle</item>
        <item name="android:navigationBarColor">@color/default_nav_color</item>
        <item name="actionBarTheme">@style/ThemeOverlay.ActionBar</item>
        <item name="android:windowLightStatusBar">@bool/isLightStatusBar</item>
    </style>

    <style name="BrowserThemeDayNight.NoTitle" parent="@style/BrowserThemeDayNight">
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="BrowserThemeDayNight.Browser" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="android:colorBackground">@color/md3_surface</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md3_on_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <item name="android:textColorPrimary">@color/md3_on_surface</item>
        <item name="android:textColorSecondary">@color/md3_on_surface_variant</item>
        <item name="android:windowBackground">@color/md3_surface</item>
        <item name="android:navigationBarColor">@color/md3_navigation_bar_bg</item>
        <item name="android:statusBarColor">@color/md3_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="colorPrimaryDark">@color/md3_primary_dark</item>
    </style>

    <style name="BrowserThemeDayNight.CustomToolbar" parent="BrowserThemeDayNight.NoTitle">
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="BrowserThemeDayNight.Transparent" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="BrowserThemeDayNight.Pref" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="android:colorBackground">@color/md3_surface</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md3_on_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <item name="android:textColorPrimary">@color/md3_on_surface</item>
        <item name="android:textColorSecondary">@color/md3_on_surface_variant</item>
        <item name="android:windowBackground">@color/md3_surface</item>
        <item name="android:navigationBarColor">@color/md3_navigation_bar_bg</item>
        <item name="android:statusBarColor">@color/md3_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="iconColor">@color/md3_on_surface_variant</item>
        <item name="urlBarBoxColor">@color/md3_surface_container_high</item>
        <item name="urlBarBoxBorderColor">@color/md3_outline_variant</item>
    </style>

    <style name="ThemeOverlay.ActionBar" parent="">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:colorPrimary">@color/primary</item>
    </style>

    <style name="Widget.Yuzu.SpinnerButton" parent="Widget.AppCompat.Spinner">
        <item name="android:textAppearance">
            @style/TextAppearance.AppCompat.Widget.TextView.SpinnerItem
        </item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:textAlignment">inherit</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.Yuzu.WebView" parent="@android:style/Widget.WebView">
        <item name="android:scrollbarThumbVertical">@color/scroll_bar</item>
        <item name="android:scrollbarThumbHorizontal">@color/scroll_bar</item>
        <item name="android:scrollbarSize">4dp</item>
    </style>

    <style name="EditTextStyle" parent="@style/Widget.AppCompat.EditText"/>

    <style name="Widget.MaterialProgressBar.ProgressBar.Horizontal" parent="android:Widget.ProgressBar.Horizontal">
        <!--
        Disabled for correct behavior on Android 4.x, see
        https://github.com/android/platform_frameworks_base/commit/911743652b597057a1bd7ef8a921e9ff8dce0f4a#diff-149f45c5ff2d3185bb79688ba17bc432L536
        <item name="android:progressDrawable">@null</item>
        -->
        <item name="android:indeterminateDrawable">@null</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
    </style>

    <style name="BrowserThemeDayNight_BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MD3_BottomSheet</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="MD3_BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/md3_surface</item>
        <item name="shapeAppearanceOverlay">@style/MD3_BottomSheet_Shape</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="MD3_BottomSheet_Shape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeTopLeft">28dp</item>
    </style>

    <style name="MenuBottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MenuBottomSheetStyle</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
    </style>

    <style name="MenuBottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/md3_surface</item>
        <item name="shapeAppearanceOverlay">@style/MenuBottomSheetShape</item>
        <item name="elevation">0dp</item>
        <item name="behavior_hideable">true</item>
        <item name="behavior_skipCollapsed">true</item>
    </style>

    <style name="MenuBottomSheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeTopLeft">20dp</item>
    </style>

    <style name="TextAppearance" parent="android:TextAppearance" tools:ignore="UnusedResources"/>

    <style name="TextAppearance.SingleTitle">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.ListTitle">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.ListBody">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ActionModeStyle" parent="@style/Widget.AppCompat.ActionMode">
        <item name="background">@color/action_mode_background</item>
    </style>
</resources>
