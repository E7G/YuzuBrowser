<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="model"
            type="jp.hazuki.yuzubrowser.search.model.SearchSuggestModel.SuggestModel"/>
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/md3_surface"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:text="@{model.suggest}"
            android:textColor="@color/md3_on_surface"
            android:textSize="16sp"/>

        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/md3_icon_button_bg"
            android:scaleType="center"
            android:padding="8dp"
            android:tint="@color/md3_on_surface_variant"
            android:src="@drawable/ic_reply_black_24dp"/>

    </LinearLayout>
</layout>
